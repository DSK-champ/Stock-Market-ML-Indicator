# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/
ENV/

# Python tooling and test caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter Notebook
.ipynb_checkpoints/

# Secrets and environment files
.env
.env.*
!.env.example
!.env.sample

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx

# Data and generated datasets
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
data/processed/master.csv
ML/data/processed/master.csv

# Machine learning artifacts

# Ignore generated model files by default
ML/models/*
!ML/models/.gitkeep

# Generated plots and reports
ML/reports/figures/*
!ML/reports/figures/.gitkeep
ML/results/oof/*
!ML/results/oof/.gitkeep
ML/scratch/*

# Frontend / Node.js
node_modules/
dist/
build/
.next/
.nuxt/
.output/
coverage/
.vite/

# Environment files in frontend/backend
frontend/.env
frontend/.env.*
!frontend/.env.example

backend/.env
backend/.env.*
!backend/.env.example

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Logs and temporary files
*.log
logs/
tmp/
temp/
